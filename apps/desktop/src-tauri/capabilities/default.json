{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the OpenDoc main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-create-document",
    "allow-get-document",
    "allow-add-paragraph",
    "allow-add-heading",
    "allow-add-link",
    "allow-add-mention",
    "allow-add-footnote-ref",
    "allow-add-equation",
    "allow-add-equation-block",
    "allow-add-list-item",
    "allow-add-page-break",
    "allow-add-table",
    "allow-add-citation",
    "allow-add-comment",
    "allow-add-suggestion",
    "allow-update-inline-text",
    "allow-delete-comment-thread",
    "allow-accept-suggestion",
    "allow-reject-suggestion",
    "allow-add-text-mark",
    "allow-update-block-equation-source",
    "allow-set-spreadsheet-cell",
    "allow-update-bibliography-reference",
    "allow-save-local-repository",
    "allow-open-local-repository",
    "allow-sign-with-openssh-private-key",
    "allow-verify-current-signature"
  ]
}
