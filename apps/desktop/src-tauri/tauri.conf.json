{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenDoc",
  "version": "0.1.0",
  "identifier": "org.opendoc.prototype",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:app",
    "devUrl": "http://127.0.0.1:10084",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "OpenDoc",
        "width": 1180,
        "height": 820,
        "minWidth": 860,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
